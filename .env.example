# Tor Proxy Configuration
# Copy this file to .env and modify as needed
# cp .env.example .env

# SOCKS5 proxy port
SOCKS_PORT=9150

# DNS resolution port
DNS_PORT=5353

# Enable Tor logging to stdout (visible via docker logs)
ENABLE_LOG=false

# Exit node country selection (ISO country codes)
# Examples: {US}, {DE}, {GB}, {NL}, {TR}
# Multiple countries: {US},{GB},{DE}
# Leave empty to use any exit node (default)
EXIT_NODES=

# Only use specified exit nodes (0=off, 1=on)
# Warning: Setting to 1 with EXIT_NODES may slow down bootstrap
STRICT_NODES=0

# Tor Bridge configuration (for censored networks)
# Get bridges from: https://bridges.torproject.org
USE_BRIDGE=false

# Bridge type: obfs4, meek, snowflake
BRIDGE_TYPE=

# Bridge addresses (semicolon-separated for multiple bridges)
# Example: obfs4 1.2.3.4:443 FINGERPRINT cert=... iat-mode=0;obfs4 5.6.7.8:443 FINGERPRINT cert=... iat-mode=0
BRIDGE_LINES=
